{
  "name": "@leash/hyperliquid",
  "version": "0.0.1",
  "private": true,
  "description": "Execution layer for trading agents on Hyperliquid — risk limits enforced outside the model.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "leash-hyperliquid": "./dist/bin/serve.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "serve": "npm run build && node dist/bin/serve.js",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@msgpack/msgpack": "^3.1.3",
    "viem": "^2.56.7",
    "zod": "^4.6.5"
  }
}
