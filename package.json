{
  "name": "@r2rlabs/reins",
  "version": "0.1.2",
  "description": "Execution layer for trading agents on Hyperliquid — risk limits enforced outside the model.",
  "license": "MIT",
  "keywords": [
    "hyperliquid",
    "mcp",
    "trading",
    "agent",
    "risk",
    "ai",
    "claude",
    "perps"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "reins": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p examples/demo-agent",
    "build": "tsc -p tsconfig.build.json",
    "serve": "npm run build && node dist/bin/serve.js",
    "check": "npm run typecheck && npm run test && npm run build",
    "demo": "node examples/demo-agent/agent.ts",
    "demo:report": "node examples/demo-agent/report.ts",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@msgpack/msgpack": "^3.1.3",
    "viem": "^2.56.7",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
